  year = {1998},
  month = feb,
  journal = {Annual Review of Psychology},
  volume = {49},
  number = {1},
  pages = {65--85},
  issn = {0066-4308, 1545-2085},
  doi = {10.1146/annurev.psych.49.1.65},
  urldate = {2023-10-04},
  abstract = {▪ Abstract{\enspace} Allport specified four conditions for optimal intergroup contact: equal group status within the situation, common goals, intergroup cooperation and authority support. Varied research supports the hypothesis, but four problems remain. 1. A selection bias limits cross-sectional studies, since prejudiced people avoid intergroup contact. Yet research finds that the positive effects of cross-group friendship are larger than those of the bias. 2. Writers overburden the hypothesis with facilitating, but not essential, conditions. 3. The hypothesis fails to address process. The chapter proposes four processes: learning about the outgroup, changed behavior, affective ties, and ingroup reappraisal. 4. The hypothesis does not specify how the effects generalize to other situations, the outgroup or uninvolved outgroups. Acting sequentially, three strategies enhance generalization---decategorization, salient categorization, and recategorization. Finally, both individual differences and societal norms shape intergroup contact effects. The chapter outlines a longitudinal intergroup contact theory. It distinguishes between essential and facilitating factors, and emphasizes different outcomes for different stages of contact.},
  langid = {english}
}

@article{pierson_when_1993,
  title = {When {{Effect Becomes Cause}}: {{Policy Feedback}} and {{Political Change}}},
  shorttitle = {When {{Effect Becomes Cause}}},
  author = {Pierson, Paul},
  year = {1993},
  month = jul,
  journal = {World Politics},
  volume = {45},
  number = {4},
  pages = {595--628},
  issn = {0043-8871, 1086-3338},
  doi = {10.2307/2950710},
  urldate = {2024-10-30},
  abstract = {As governmental activity has expanded, scholars have been increasingly inclined to suggest that the structure of public policies has an important influence on patterns of political change. Yet research on policy feedback is mostly anecdotal, and there has so far been little attempt to develop more general hypotheses about the conditions under which policies produce politics. Drawing on recent research, this article suggests that feedback occurs through two main mechanisms. Policies generate resources and incentives for political actors, and they provide those actors with information and cues that encourage particular interpretations of the political world. These mechanisms operate in a variety of ways, but have significant effects on government elites, interest groups, and mass publics. By investigating how policies influence different actors through these distinctive mechanisms, the article outlines a research agenda for moving from the current focus on illustrative case studies to the investigation of broader propositions about how and when policies are likely to be politically consequential.},
  copyright = {https://www.cambridge.org/core/terms},
  langid = {english}
}

@article{pinon_survey_2024,
  title = {A Survey Conjoint Experiment on the Role of Politicization and Institutionalization in Public Opinion.},
  author = {Pinon, Vin{\'i}cius},
  year = {2024},
  publisher = {OSF Registries},
  doi = {10.17605/OSF.IO/R3PSA},
  urldate = {2024-08-12},
  abstract = {Can institutionalization reduce affective polarization? In this study, we aim to analyze factors beyond people's perceptions of public policies. Specifically, we will operationalize ``institutionalization'' and ``politicization'' of policies to demonstrate how the perceived characteristics of public policies can increase or decrease public support, particularly among individuals with differing political views. This study is part of a master's thesis at the Brazilian School of Public and Business Administration (FGV-EBAPE). This document outlines the design, expected results, and analysis plan of a conjoint survey experiment approved by the Committee for Ethical Compliance in Research Involving Human Beings at the Get{\'u}lio Vargas Foundation (FGV). The survey will ask participants about their political alignment with a party and the country's former presidents, their perceived level of institutionalization of certain federal public policies, their evaluation of these policies, and the association they perceive (or not) between policies and specific politicians. We expect the data analysis to reveal: i) a positive association between individuals' positive partisanship and the evaluation of policies they perceive as aligned with their preferred parties; ii) a negative association between individuals' negative partisanship and the evaluation of policies they perceive as aligned with their least-favored parties; iii) a positive association between perceived institutionalization of the policies and their evaluation.},
  collaborator = {{Center For Open Science}},
  copyright = {Creative Commons Attribution 4.0 International},
  keywords = {FOS: Political science,Political Science,Social and Behavioral Sciences}
}

